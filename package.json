{
  "name": "@lucvmf/kyro",
  "version": "0.1.0",
  "description": "A production-ready Discordeno framework for commands, events, components, plugins, and services.",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "restricted"
  },
  "module": "index.ts",
  "main": "dist/index.js",
  "types": "index.ts",
  "bin": {
    "kyro": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun build index.ts src/cli.ts --outdir dist --target node --packages external",
    "prepublishOnly": "bun run format:check && bun run check && bun test && bun run build"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "discordeno": "^21.0.0",
    "drizzle-orm": "^0.45.2",
    "moonlink.js": "^5.2.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3"
  }
}
